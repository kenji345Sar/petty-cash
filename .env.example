# docker-compose.prod.yml 用の設定例
# このファイルを .env にコピーして、実際の値を入れてください（.env は Git 管理外）
#
#   cp .env.example .env
#   docker compose -f docker-compose.prod.yml up -d

# --- データベース ---
# POSTGRES_PASSWORD は必須。未設定だと compose が起動を中止します。
# 本番では必ず推測できない値に変えてください（例: openssl rand -base64 32）
POSTGRES_PASSWORD=change-me
POSTGRES_DB=petty_cash
POSTGRES_USER=postgres

# --- CORS 許可オリジン ---
# フロントエンドを公開するURLに合わせて変更してください
CORS_ORIGIN_0=http://localhost:8080
CORS_ORIGIN_1=http://localhost
